# BreathPrint — environment variables
#
# Copy to .env.local in the consuming app (apps/web) and fill in real values.
# NEXT_PUBLIC_ prefix because the SDK runs in the browser.

# Helius RPC (devnet) — also serves as Light Protocol compression indexer
# Get a key at https://www.helius.dev
NEXT_PUBLIC_HELIUS_API_KEY=your-helius-api-key

# Anchor program ID — replace after `anchor deploy`
NEXT_PUBLIC_BREATHPRINT_PROGRAM_ID=BPrnt1111111111111111111111111111111111111

# Solana cluster: devnet | mainnet-beta | localnet
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Circuit artifact paths (served from /public)
NEXT_PUBLIC_CIRCUIT_REGISTRATION_WASM=/circuits/breath_identity.wasm
NEXT_PUBLIC_CIRCUIT_REGISTRATION_ZKEY=/circuits/breath_identity_final.zkey
NEXT_PUBLIC_CIRCUIT_VERIFICATION_WASM=/circuits/breath_identity_v.wasm
NEXT_PUBLIC_CIRCUIT_VERIFICATION_ZKEY=/circuits/breath_identity_v_final.zkey
